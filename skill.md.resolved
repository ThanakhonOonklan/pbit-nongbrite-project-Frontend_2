## 📁 โครงสร้าง src/

```
src/
├── app/                    # Next.js App Router
│   ├── page.tsx            # Landing
│   ├── login/
│   ├── register/
│   ├── forget-password/
│   ├── courses/
│   ├── games/
│   │   ├── path-navigation/[level]/
│   │   ├── counting-classification/[level]/
│   │   ├── conditional-matching/[level]/
│   │   ├── sequencing/[level]/
│   │   ├── step-counting/[level]/
│   │   ├── fruit-matching-grid/[level]/
│   │   └── grid-based-coloring/[level]/
│   ├── profile/
│   ├── rank/
│   └── settings/
├── components/
│   ├── auth/               # LoginForm, RegisterForm, ForgetPasswordForm
│   ├── games/              # GameHeader, GameHearts, TutorialModal, GameResultModal
│   │   ├── path-navigation/
│   │   ├── counting-classification/
│   │   ├── conditional-matching/
│   │   ├── sequencing/
│   │   ├── step-counting/
│   │   ├── fruit-matching-grid/
│   │   ├── grid-based-coloring/
│   │   └── tutorials/      # Tutorial step components ทุกเกม
│   ├── landing/            # HeroSection, FeaturesSection, StatsSection, CTA
│   ├── layout/             # Navbar, Sidebar
│   ├── courses/            # GameCard, GameStepper, ResourceBars
│   └── common/             # StarRating, LoadingOverlay, BackgroundSquares
├── store/                  # Zustand stores
│   ├── auth.store.ts
│   ├── user.store.ts       # life, streak, profile
│   ├── chapter.store.ts
│   └── rank.store.ts
├── services/               # API calls
│   ├── auth.service.ts
│   ├── game.service.ts     # submitScore
│   ├── user.service.ts
│   └── chapter.service.ts
├── constants/
│   └── games/              # level configs ทุกเกม
├── utils/
│   ├── game-scoring.ts     # calculateGameScore, getStarRating
│   └── level-mapper.ts     # getAbsoluteLevelId
└── messages/
    ├── th.json             # ภาษาไทย
    └── en.json             # ภาษาอังกฤษ
```

