    "Games": {
      "path-navigation": {
        "title": "Path Navigation",
        "description": "Draw a path to guide P'Bit through the grid to the correct destination. Develops logical thinking and systematic planning skills."
      },
      "counting-classification": {
        "title": "Counting & Classification",
        "description": "Find and count the hidden shapes based on given conditions. Enhances observation and classification skills."
      },
      "conditional-matching": {
        "title": "Conditional Matching",
        "description": "Analyze the given conditions and select the matching item. Practices conditional logic and analytical thinking (If-Then)."
      },
      "sequencing": {
        "title": "Sequencing",
        "description": "Arrange the picture events in the correct chronological order. Learn about sequential processes and algorithmic thinking."
      },
      "step-counting": {
        "title": "Loop Patterns",
        "description": "Select and loop ingredients to make a smoothie based on a recipe. Learn the fundamentals of loops in basic programming."
      },
      "fruit-matching-grid": {
        "title": "Fruit Matching Grid",
        "description": "Memorize the positions of fruits in the grid, then select the correct fruit to fill in the missing spots to test memory and observation skills."
      },
      "grid-based-coloring": {
        "title": "Grid-based Coloring",
        "description": "Memorize and color the grid to match the original pattern. Enhances memory, spatial matching skills, and observation."
      }
    }
